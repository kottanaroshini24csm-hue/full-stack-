<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My To-Do List</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: #f1f5f9;
    }

    .todo-container {
      width: 100%;
      max-width: 600px;
      padding: 30px;
      background: white;
      border-radius: 12px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    h1 {
      margin-top: 0;
      text-align: center;
      color: #1e293b;
    }

    .input-area {
      display: flex;
      gap: 10px;
      margin-bottom: 25px;
    }

    #taskInput {
      flex: 1;
      padding: 12px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      font-size: 16px;
    }

    #addTaskButton {
      padding: 12px 18px;
      border: none;
      border-radius: 6px;
      color: white;
      background: #2563eb;
      cursor: pointer;
      font-size: 15px;
    }

    #addTaskButton:hover {
      background: #1d4ed8;
    }

    #emptyMessage {
      text-align: center;
      color: #64748b;
      padding: 20px;
    }

    .task-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px;
      margin-bottom: 10px;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      background: #f8fafc;
    }

    .task-text {
      flex: 1;
      color: #1e293b;
      font-size: 16px;
    }

    .completed .task-text {
      color: #94a3b8;
      text-decoration: line-through;
    }

    .complete-button,
    .delete-button {
      padding: 8px 12px;
      border: none;
      border-radius: 5px;
      color: white;
      cursor: pointer;
    }

    .complete-button {
      background: #10b981;
    }

    .complete-button:hover {
      background: #059669;
    }

    .delete-button {
      background: #ef4444;
    }

    .delete-button:hover {
      background: #dc2626;
    }

    @media (max-width: 500px) {
      .input-area {
        flex-direction: column;
      }

      .task-item {
        flex-wrap: wrap;
      }

      .task-text {
        width: 100%;
        flex-basis: 100%;
      }
    }
  </style>
</head>
<body>

  <div class="todo-container">
    <h1>My To-Do List</h1>

    <div class="input-area">
      <input
        type="text"
        id="taskInput"
        placeholder="Enter a task..."
      />

      <button id="addTaskButton">
        Add Task
      </button>
    </div>

    <p id="emptyMessage">
      No tasks available.
    </p>

    <div id="taskList"></div>
  </div>

  <script>
    // Select elements from the webpage
    const taskInput = document.getElementById("taskInput");
    const addTaskButton = document.getElementById("addTaskButton");
    const taskList = document.getElementById("taskList");
    const emptyMessage = document.getElementById("emptyMessage");

    // Add a new task
    function addTask() {
      const taskText = taskInput.value.trim();

      // Do not add an empty task
      if (taskText === "") {
        alert("Please enter a task.");
        return;
      }

      // Create the task container
      const taskItem = document.createElement("div");
      taskItem.className = "task-item";

      // Create the task text
      const taskName = document.createElement("span");
      taskName.className = "task-text";
      taskName.textContent = taskText;

      // Create the Complete button
      const completeButton = document.createElement("button");
      completeButton.className = "complete-button";
      completeButton.textContent = "Complete";

      // Complete button event listener
      completeButton.addEventListener("click", function () {
        taskItem.classList.toggle("completed");

        if (taskItem.classList.contains("completed")) {
          completeButton.textContent = "Undo";
        } else {
          completeButton.textContent = "Complete";
        }
      });

      // Create the Delete button
      const deleteButton = document.createElement("button");
      deleteButton.className = "delete-button";
      deleteButton.textContent = "Delete";

      // Delete button event listener
      deleteButton.addEventListener("click", function () {
        taskItem.remove();
        updateEmptyMessage();
      });

      // Add elements to the task item
      taskItem.appendChild(taskName);
      taskItem.appendChild(completeButton);
      taskItem.appendChild(deleteButton);

      // Add the task item to the task list
      taskList.appendChild(taskItem);

      // Clear the input
      taskInput.value = "";

      // Hide the empty message
      updateEmptyMessage();
    }

    // Show or hide the empty-list message
    function updateEmptyMessage() {
      if (taskList.children.length === 0) {
        emptyMessage.style.display = "block";
      } else {
        emptyMessage.style.display = "none";
      }
    }

    // Add task when the button is clicked
    addTaskButton.addEventListener("click", addTask);

    // Add task when Enter is pressed
    taskInput.addEventListener("keydown", function (event) {
      if (event.key === "Enter") {
        addTask();
      }
    });

    // Set the correct initial empty state
    updateEmptyMessage();
  </script>

</body>
</html>
