class Animal {
    eat() {
        console.log("Animal is eating");
    }
}

class Dog extends Animal {
    bark() {
        console.log("Dog is barking");
    }
}

class Cat extends Animal {
    meow() {
        console.log("Cat is meowing");
    }
}

let d = new Dog();
d.eat();
d.bark();

let c = new Cat();
c.eat();
c.meow();
